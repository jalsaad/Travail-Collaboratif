// ---------------------------------------------------------------------------
// Modèle de données — App de travail collaboratif (Circulaire 8894 / 7167)
// PostgreSQL + Prisma
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

/// Rôle d'un membre au sein d'UNE école donnée.
/// Un même User peut avoir des rôles différents selon l'école (ex: référent
/// dans son école principale, enseignant dans une école secondaire).
enum Role {
  DIRECTION
  REFERENT_NUMERIQUE
  ENSEIGNANT
}

enum Sex {
  M
  F
}

/// Niveau d'enseignement offert par une école — tableau car une école
/// "fondamentale" combine souvent MATERNELLE et PRIMAIRE.
enum SchoolLevel {
  MATERNELLE
  PRIMAIRE
  SECONDAIRE
}

/// Type d'enseignement — tableau par symétrie avec SchoolLevel, même si la
/// combinaison des deux valeurs reste rare en pratique.
enum EducationType {
  ORDINAIRE
  SPECIALISE
}

enum MembershipStatus {
  ACTIVE
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

/// École créée via le flux public "créer mon école" : reste PENDING tant
/// que la plateforme ne l'a pas validée (aucune fonctionnalité opérationnelle
/// pour ses membres avant ça — cf. app/(app)/layout.tsx). Les écoles déjà
/// existantes (seed, création manuelle) restent APPROVED par défaut.
enum SchoolStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Les DEUX seules formes de travail collaboratif ayant valeur normative
/// (circulaire 7167 du 03/06/2019, sous-section 5, et son vade-mecum §2) :
/// a. participation aux réunions des équipes pédagogique et éducative
///    (initiative direction) ;
/// b. collaboration à visée pédagogique soutenue par la direction, y compris
///    avec d'autres établissements ou centres PMS (initiative enseignants).
/// La direction doit pouvoir suivre l'équilibre entre les deux — d'où le
/// maintien de cette distinction, la qualification fine passant par
/// CollaborativePeriod.natureActivite.
enum PeriodType {
  REUNION_EQUIPE
  COLLABORATION_PEDAGOGIQUE
}

/// Statut de confirmation d'UN participant sur une période. Le statut
/// "global" affiché à l'écran (validée / en attente) se déduit de l'état
/// de l'ensemble des PeriodParticipant liés à la période.
enum ParticipantStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum ExportFormat {
  PDF
  XLSX
}

enum ExportScope {
  INDIVIDUAL
  SCHOOL
  /// Export ciblé sur un sous-ensemble choisi de personnes (ni une seule, ni
  /// la totalité de l'école) — cf. ExportLog.targetUserIds.
  BATCH
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum DonationStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ---------------------------------------------------------------------------
// IDENTITÉ & ÉCOLES
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  firstName           String
  lastName            String
  passwordHash        String?
  dateOfBirth         DateTime?
  sex                 Sex?
  /// Numéro à 11 chiffres calculé à la création du compte (cf. lib/matricule.ts) :
  /// 1 chiffre sexe + 2 chiffres décennie de naissance + 2 chiffres mois +
  /// 2 chiffres jour + 4 chiffres encodés manuellement par l'utilisateur.
  /// Nullable : les comptes créés avant l'introduction de ce champ n'en ont pas.
  matricule           String?   @unique
  /// Compte plateforme, transverse à toutes les écoles — distinct des rôles
  /// Membership (qui restent scopés à une école). Réservé à l'équipe produit
  /// pour assister les directions ; ne pas confondre avec Role.DIRECTION.
  isSuperAdmin        Boolean   @default(false)
  lastLoginAt         DateTime?
  /// Note de satisfaction courante (1 à 5), modifiable à tout moment depuis
  /// le widget étoiles du menu (cf. components/satisfaction-stars.tsx) — une
  /// seule valeur "actuelle" par compte, pas un historique.
  satisfactionRating  Int?
  satisfactionRatedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  memberships          Membership[]
  createdPeriods       CollaborativePeriod[] @relation("PeriodAuthor")
  periodParticipations PeriodParticipant[]
  invitationsSent      Invitation[]          @relation("InvitationsSentBy")
  exportsRequested     ExportLog[]
  auditLogs            AuditLog[]
  announcementsCreated Announcement[]
  announcementReads    AnnouncementRead[]
  donations            Donation[]
  passwordResetTokens  PasswordResetToken[]
  supportTickets       SupportTicket[]

  @@map("users")
}

/// Lien de réinitialisation de mot de passe envoyé par email (cf.
/// lib/mailer.ts). Seul un hash SHA-256 du token est stocké — le token brut
/// ne vit que dans l'URL emailée, jamais en base. Usage unique (usedAt) et
/// expirant (1h) ; toute nouvelle demande supprime les tokens non utilisés
/// précédents de cet utilisateur (cf. app/(auth)/mot-de-passe-oublie/actions.ts).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Ticket de support créé depuis le bouton "Assistance" du menu (cf.
/// components/nav.tsx) — catégorise une demande d'aide ou un signalement
/// d'incident, traité depuis /admin/assistance par l'administrateur
/// plateforme. L'email de contact est celui du compte (pas resaisi dans le
/// formulaire), cf. app/(app)/assistance/actions.ts.
enum SupportTicketCategory {
  ASSISTANCE
  INCIDENT
}

enum SupportTicketStatus {
  OPEN
  RESOLVED
}

model SupportTicket {
  id             String                @id @default(cuid())
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// École et rôle actifs de l'auteur au moment de la création du ticket —
  /// déduits automatiquement de sa Membership active (cf.
  /// lib/active-school.ts::resolveActiveMembership), jamais demandés dans le
  /// formulaire. Nullables : un compte sans école active peut aussi ouvrir un
  /// ticket (ex: administrateur plateforme pur).
  schoolId       String?
  school         School?               @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  role           Role?
  category       SupportTicketCategory
  subject        String
  message        String
  /// Pièce jointe facultative (capture d'écran, PDF...) : URL renvoyée par le
  /// stockage (cf. lib/file-storage.ts) et nom d'origine, conservé pour
  /// l'affichage seul — le fichier stocké porte un nom aléatoire.
  attachmentUrl  String?
  attachmentName String?
  status         SupportTicketStatus   @default(OPEN)
  createdAt      DateTime              @default(now())
  resolvedAt     DateTime?

  @@index([status])
  @@map("support_tickets")
}

model School {
  id                String          @id @default(cuid())
  name              String
  /// Réseau d'enseignement (WBE, officiel subventionné, libre subventionné...)
  reseau            String?
  /// Région/province — texte libre (pas d'enum : les découpages varient),
  /// renseigné par l'admin plateforme (cf. AdminSchoolEditForm).
  region            String?
  /// Niveaux offerts (maternelle/primaire/secondaire) — admin uniquement.
  niveaux           SchoolLevel[]   @default([])
  /// Type(s) d'enseignement (ordinaire/spécialisé) — admin uniquement.
  typesEnseignement EducationType[] @default([])
  /// Numéro FASE / matricule officiel de l'établissement
  numeroFase        String?         @unique
  /// Rue et numéro. Les écoles créées avant le découpage de l'adresse y ont
  /// encore leur adresse complète en texte libre (code postal et localité
  /// restent alors vides jusqu'à la prochaine édition du formulaire).
  address           String?
  /// Code postal belge à 4 chiffres — cf. lib/belgian-postal-codes.ts.
  postalCode        String?
  /// Localité correspondant au code postal (un code en dessert plusieurs).
  locality          String?
  /// Pays, renseigné uniquement pour les écoles à programme belge à
  /// l'étranger (cf. lib/reseau-options.ts::isReseauEtranger). Vide pour les
  /// écoles situées en Belgique, dont le code postal suffit à localiser.
  country           String?
  phone             String?
  /// Logo affiché dans l'espace école (personnalisation par la direction)
  logoUrl           String?
  status            SchoolStatus    @default(APPROVED)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  implantations       Implantation[]
  memberships         Membership[]
  invitations         Invitation[]
  joinCodes           JoinCode[]
  exportLogs          ExportLog[]
  auditLogs           AuditLog[]
  announcementTargets AnnouncementTarget[]
  supportTickets      SupportTicket[]

  @@map("schools")
}

/// Site/implantation d'une école à adresses multiples.
model Implantation {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  address  String?

  memberships Membership[]

  @@map("implantations")
}

/// Année scolaire de référence, partagée par toutes les écoles (calendrier
/// commun FWB), utilisée pour scoper quotas, périodes et exports.
model SchoolYear {
  id        String   @id @default(cuid())
  /// Ex: "2025-2026"
  label     String   @unique
  startDate DateTime
  endDate   DateTime

  annualAssignments    AnnualAssignment[]
  collaborativePeriods CollaborativePeriod[]
  exportLogs           ExportLog[]

  @@map("school_years")
}

// ---------------------------------------------------------------------------
// APPARTENANCE & RÔLES
// ---------------------------------------------------------------------------

/// Rattachement d'un User à une School, avec son rôle. Un enseignant
/// partagé entre plusieurs écoles a une Membership par école.
model Membership {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId       String
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  implantationId String?
  implantation   Implantation?    @relation(fields: [implantationId], references: [id])
  role           Role
  /// Intitulé déclaratif choisi à l'inscription ("Direction", "Direction
  /// adjointe", "Autre") — distinct de `role` qui reste la seule source des
  /// permissions réelles. Direction/Direction adjointe → role DIRECTION,
  /// Autre → role REFERENT_NUMERIQUE (cf. app/(auth)/creer-ecole/actions.ts).
  fonction       String?
  /// Précision libre saisie uniquement quand fonction = "Autre".
  fonctionAutre  String?
  status         MembershipStatus @default(ACTIVE)
  /// true pour le compte ayant créé l'espace école (non rétrogradable)
  isAccountOwner Boolean          @default(false)
  joinedAt       DateTime         @default(now())
  removedAt      DateTime?

  annualAssignments  AnnualAssignment[]
  authoredInvitation Invitation[]           @relation("InvitationAcceptedAs")
  periodParticipants PeriodParticipant[]
  levelHours         MembershipLevelHours[]

  @@unique([userId, schoolId])
  @@map("memberships")
}

/// Discipline/matière enseignée. Rattachée à chaque MembershipLevelHours (et
/// non à la Membership globalement) car un même enseignant peut donner des
/// disciplines différentes selon le niveau, y compris plusieurs disciplines
/// dans le MÊME niveau (plusieurs lignes de même niveau, discipline
/// différente) — cf. commentaire de MembershipLevelHours. Sert aussi au
/// ciblage des annonces plateforme.
model Discipline {
  id   String  @id @default(cuid())
  /// Libellé affiché — pas la clé d'unicité (cf. code) : deux "fonctions"
  /// officielles distinctes (ex: Français degré inférieur / degré
  /// supérieur) peuvent légitimement partager le même libellé usuel.
  name String
  /// Code officiel de la fonction (référentiel FWB — cf. lib/disciplines.ts,
  /// décret Titres & Fonctions) : identifiant stable et interopérable avec
  /// les documents administratifs, "c'est lui qu'on stocke, pas le libellé".
  /// Nullable : disciplines créées en texte libre avant l'introduction du
  /// référentiel (jamais reproposées par le sélecteur, mais toujours
  /// valides pour les données existantes).
  code String? @unique

  levelHours MembershipLevelHours[]
  targets    AnnouncementTarget[]

  @@map("disciplines")
}

/// ETP et objectif annuel de périodes pour une Membership donnée, recalculés
/// chaque année scolaire (l'ETP d'un enseignant peut varier d'une année à
/// l'autre, tout comme sa répartition entre écoles).
///
/// Règles Circulaire 8894 à appliquer en couche applicative :
/// - etp d'une Membership = somme, sur ses MembershipLevelHours, de
///   (heures déclarées / heures temps plein du niveau) — cf. lib/quota-engine.ts.
/// - Quota (objectifPeriodes) calculé sur l'ETP TOTAL de l'utilisateur (somme
///   sur toutes ses écoles) : 60 périodes pour un temps plein (ETP >= 1),
///   proportionnellement adaptées en deçà (60 * ETP total) — un mi-temps doit
///   30 périodes. Ce total est ensuite réparti entre écoles au prorata de
///   l'ETP de chacune — cf. lib/quota-engine.ts::recomputeUserQuotas.
/// - somme des (objectifPeriodes / 36 semaines) sur toutes les écoles d'un
///   même User, pour une même SchoolYear, ne peut dépasser l'équivalent de
///   2 périodes/semaine.
model AnnualAssignment {
  id               String     @id @default(cuid())
  membershipId     String
  membership       Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  schoolYearId     String
  schoolYear       SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  etp              Decimal    @db.Decimal(4, 2)
  objectifPeriodes Decimal    @db.Decimal(5, 2)

  @@unique([membershipId, schoolYearId])
  @@map("annual_assignments")
}

/// Niveau(x) enseigné(s) déclarés pour UNE Membership, avec les heures/semaine
/// et la discipline correspondantes — saisis à l'inscription (cf.
/// LevelHoursPicker), une Membership pouvant combiner plusieurs niveaux (ex:
/// mi-temps primaire + mi-temps secondaire inférieur dans la même école).
/// Un même niveau peut apparaître plusieurs fois (sur des lignes distinctes)
/// si l'enseignant y donne plusieurs disciplines — @@unique porte donc sur
/// (membership, niveau, discipline), pas sur (membership, niveau) seul.
/// Sert de base au calcul de l'ETP (lib/quota-engine.ts), jamais recalculé
/// automatiquement après l'inscription.
enum TeachingLevel {
  MATERNELLE
  PRIMAIRE
  SECONDAIRE_INFERIEUR
  SECONDAIRE_SUPERIEUR
}

model MembershipLevelHours {
  id           String        @id @default(cuid())
  membershipId String
  membership   Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  level        TeachingLevel
  hours        Decimal       @db.Decimal(4, 2)
  disciplineId String
  discipline   Discipline    @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@unique([membershipId, level, disciplineId])
  @@map("membership_level_hours")
}

// ---------------------------------------------------------------------------
// INVITATIONS & CODE D'ACCÈS
// ---------------------------------------------------------------------------

/// Code générique permettant à un enseignant de rejoindre une école
/// (flux "code d'école", distinct des invitations nominatives par email).
model JoinCode {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  code          String    @unique
  active        Boolean   @default(true)
  createdById   String
  createdAt     DateTime  @default(now())
  /// Régénérer un code désactive l'ancien plutôt que de le supprimer,
  /// pour conserver la traçabilité des rattachements passés.
  deactivatedAt DateTime?

  @@index([schoolId, active])
  @@map("join_codes")
}

/// Invitation nominative par email, avec attribution du rôle cible.
model Invitation {
  id           String           @id @default(cuid())
  schoolId     String
  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email        String
  role         Role
  status       InvitationStatus @default(PENDING)
  invitedById  String
  invitedBy    User             @relation("InvitationsSentBy", fields: [invitedById], references: [id])
  token        String           @unique
  createdAt    DateTime         @default(now())
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedAsId String?
  acceptedAs   Membership?      @relation("InvitationAcceptedAs", fields: [acceptedAsId], references: [id])

  @@index([schoolId, status])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// TRAVAIL COLLABORATIF
// ---------------------------------------------------------------------------

/// Une période de travail collaboratif déclarée par un enseignant.
/// Le statut global affiché à l'écran se déduit des PeriodParticipant liés :
/// VALIDEE si tous les participants requis ont CONFIRMED, EN_ATTENTE sinon.
model CollaborativePeriod {
  id                String     @id @default(cuid())
  type              PeriodType
  date              DateTime
  /// Heure de début / de fin, format "HH:MM" en heure locale de l'école.
  /// Nullables : les périodes déclarées avant l'introduction de la plage
  /// horaire n'ont qu'une durée, et l'affichage retombe alors sur celle-ci.
  heureDebut        String?
  heureFin          String?
  /// Nombre de périodes, incréments de 0.5 possibles. Dérivé de la plage
  /// horaire à la saisie (cf. lib/period-duration.ts) mais conservé en base :
  /// c'est l'unité de l'objectif annuel et des exports.
  dureePeriodes     Decimal    @db.Decimal(4, 2)
  /// Thème de l'activité, slug du référentiel lib/collaborative-activities.ts
  /// tiré du vade-mecum §8. Facultatif : le vade-mecum précise qu'« une liste
  /// de thèmes n'est pas imposée », et les périodes antérieures n'en ont pas.
  natureActivite    String?
  description       String
  /// 4e colonne du formulaire officiel de recensement (annexe circulaire
  /// 7167) : « En lien éventuel avec quels objectifs du plan de pilotage ? ».
  /// Texte libre, facultatif comme dans le formulaire.
  objectifsPilotage String?
  schoolYearId      String
  schoolYear        SchoolYear @relation(fields: [schoolYearId], references: [id])
  createdByUserId   String
  createdBy         User       @relation("PeriodAuthor", fields: [createdByUserId], references: [id])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  participants PeriodParticipant[]
  attachments  Attachment[]

  @@index([schoolYearId, type])
  @@map("collaborative_periods")
}

/// Lien entre une période et chacun de ses participants. Le membershipId
/// fixe le contexte école dans lequel CETTE période compte pour CE
/// participant — c'est ce qui permet à une direction de ne voir, pour une
/// période inter-écoles, que la part concernant son propre personnel.
model PeriodParticipant {
  id           String              @id @default(cuid())
  periodId     String
  period       CollaborativePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  status       ParticipantStatus   @default(PENDING)
  isInitiator  Boolean             @default(false)
  confirmedAt  DateTime?

  participationTokens ParticipationToken[]

  @@unique([periodId, userId])
  @@index([membershipId, status])
  @@map("period_participants")
}

/// Jeton du bouton « Valider ma participation » des emails d'invitation
/// (cf. lib/participation-token.ts). Même invariant que PasswordResetToken :
/// seul le hash vit en base, le jeton brut n'existe que dans l'URL envoyée.
///
/// Le lien ne valide RIEN par lui-même : il ouvre une page de confirmation
/// où la personne voit la période avant de cliquer. Indispensable, car les
/// filtres anti-hameçonnage préchargent les liens des emails et valideraient
/// sinon la participation à l'insu de l'intéressé.
model ParticipationToken {
  id                  String            @id @default(cuid())
  periodParticipantId String
  periodParticipant   PeriodParticipant @relation(fields: [periodParticipantId], references: [id], onDelete: Cascade)
  tokenHash           String            @unique
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime          @default(now())

  @@index([periodParticipantId])
  @@map("participation_tokens")
}

model Attachment {
  id           String              @id @default(cuid())
  periodId     String
  period       CollaborativePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  mimeType     String
  uploadedById String
  createdAt    DateTime            @default(now())

  @@map("attachments")
}

// ---------------------------------------------------------------------------
// EXPORTS & TRAÇABILITÉ
// ---------------------------------------------------------------------------

/// Historique des exports générés (individuel ou école entière), en fin de
/// période scolaire — conservé pour audit et re-téléchargement.
model ExportLog {
  id            String       @id @default(cuid())
  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolYearId  String
  schoolYear    SchoolYear   @relation(fields: [schoolYearId], references: [id])
  scope         ExportScope
  format        ExportFormat
  /// Renseigné si scope = INDIVIDUAL
  targetUserId  String?
  /// Renseigné si scope = BATCH (liste des personnes sélectionnées par la
  /// direction/le·la référent·e — jamais utilisé pour INDIVIDUAL/SCHOOL)
  targetUserIds String[]     @default([])
  /// Bornes de la période chronologique demandée (filtre optionnel sur
  /// CollaborativePeriod.date) — nulles si l'export ne restreint pas les
  /// dates (ex: relevé collectif complet).
  rangeStart    DateTime?
  rangeEnd      DateTime?
  requestedById String
  requestedBy   User         @relation(fields: [requestedById], references: [id])
  fileUrl       String
  createdAt     DateTime     @default(now())

  @@map("export_logs")
}

/// Journal d'audit : accès et actions sensibles (changement de rôle, retrait
/// d'un membre, régénération de code, consultation de données par la
/// direction) — exigence de traçabilité RGPD évoquée dans le cahier des
/// charges.
model AuditLog {
  id         String   @id @default(cuid())
  /// Nullable : une action superadmin transverse (ex. publication d'une
  /// annonce plateforme) n'est pas rattachée à une école précise. Une
  /// action d'assistance à une école donnée doit, elle, renseigner schoolId.
  schoolId   String?
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// PLATEFORME (SUPERADMIN)
// ---------------------------------------------------------------------------

/// Annonce diffusée par le compte superadmin (ex: information de service,
/// future campagne de dons). Le ciblage se fait via AnnouncementTarget.
model Announcement {
  id          String             @id @default(cuid())
  title       String
  body        String
  status      AnnouncementStatus @default(DRAFT)
  publishAt   DateTime?
  expiresAt   DateTime?
  createdById String
  createdBy   User               @relation(fields: [createdById], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  targets AnnouncementTarget[]
  reads   AnnouncementRead[]
  media   AnnouncementMedia[]

  @@index([status, publishAt])
  @@map("announcements")
}

/// Pièce jointe média (image, vidéo, audio) intégrée à une annonce —
/// plusieurs fichiers possibles par annonce, de types mélangés.
model AnnouncementMedia {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  type           MediaType
  url            String
  mimeType       String
  createdAt      DateTime     @default(now())

  @@map("announcement_media")
}

/// Un groupe de ciblage : les critères renseignés sur UNE ligne se
/// combinent en ET (ex: role=ENSEIGNANT + disciplineId=maths => seulement
/// les profs de maths). Plusieurs lignes pour une même Announcement se
/// combinent en OU (ex: élargir à un deuxième réseau). Un critère laissé
/// à null = pas de restriction sur ce critère.
model AnnouncementTarget {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  role           Role?
  schoolId       String?
  school         School?      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Filtre sur School.reseau (ex: "WBE") — indépendant de schoolId, pour
  /// cibler tout un réseau sans lister chaque école.
  reseau         String?
  disciplineId   String?
  discipline     Discipline?  @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([reseau])
  @@index([disciplineId])
  @@map("announcement_targets")
}

/// Traçabilité de lecture/fermeture d'une annonce par destinataire.
model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  seenAt         DateTime     @default(now())
  dismissedAt    DateTime?

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

/// Don ponctuel pour soutenir la gratuité du service. Modélisé dès
/// maintenant mais la fonctionnalité reste masquée côté UI tant que le
/// FeatureFlag correspondant (clé "donations") n'est pas activé.
model Donation {
  id          String         @id @default(cuid())
  userId      String?
  user        User?          @relation(fields: [userId], references: [id])
  amountCents Int
  currency    String         @default("EUR")
  status      DonationStatus @default(PENDING)
  createdAt   DateTime       @default(now())

  @@map("donations")
}

/// Interrupteur générique pour masquer une fonctionnalité déjà modélisée
/// (ex: "donations") sans nécessiter de déploiement pour l'activer plus
/// tard. Vérifié côté service avant d'exposer toute route/écran concerné.
model FeatureFlag {
  id        String   @id @default(cuid())
  key       String   @unique
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("feature_flags")
}
