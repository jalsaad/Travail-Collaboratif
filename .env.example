DATABASE_URL="postgresql://travail_collaboratif:travail_collaboratif@localhost:5432/travail_collaboratif?schema=public"
AUTH_SECRET="generate-with-npx-auth-secret"

# Production uniquement (VPS derrière Nginx, domaine réel) — cf. next.config.mjs.
# Sans APP_ORIGIN, les Server Actions (login, formulaires...) échouent avec
# "Invalid Server Actions request." dès qu'on accède au site via son domaine.
# APP_ORIGIN="votre-domaine.tld"
# AUTH_TRUST_HOST fait confiance au header Host transmis par Nginx pour que
# NextAuth calcule les bonnes URLs de callback derrière le reverse proxy.
# AUTH_TRUST_HOST="true"

# Stockage objet S3-compatible (Cellar, OVH Object Storage, Scaleway...) pour
# les fichiers uploadés (logos d'école, médias d'annonces) — cf.
# lib/file-storage.ts. Facultatif : si absent, l'app écrit sur le disque
# local (public/uploads/...) comme avant, pratique pour développer en local
# sans compte cloud. À renseigner en production dès que l'app tourne sur
# plusieurs instances (le disque local n'est plus partagé entre elles).
# S3_ENDPOINT="https://cellar-c2.services.clever-cloud.com"
# S3_REGION="us-east-1"
# S3_BUCKET="travail-collaboratif-uploads"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL="https://travail-collaboratif-uploads.cellar-c2.services.clever-cloud.com"

# Disque supplémentaire où sont écrites les archives de fin d'année scolaire
# (cf. lib/school-year-archive.ts, bouton « Archiver » dans /admin/archives).
# Chaque archivage crée un sous-dossier <année>/ contenant archive.json et un
# relevé PDF par école ; seules les 3 dernières années sont conservées.
# Facultatif : sans cette variable, l'app écrit dans ./archives à la racine du
# projet, pratique en développement mais à ne pas utiliser en production (le
# dossier serait perdu au redéploiement).
# ARCHIVE_DIR="/mnt/archives"

# Envoi d'email (réinitialisation de mot de passe) via SMTP générique — cf.
# lib/mailer.ts. Facultatif : si SMTP_HOST est absent, le lien de
# réinitialisation est simplement affiché dans les logs du serveur au lieu
# d'être envoyé, pratique pour développer en local sans compte email.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="Travail Collaboratif <no-reply@travail-collaboratif.be>"
