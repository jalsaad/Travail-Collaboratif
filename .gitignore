public/uploads/
# Archives de fin d'année écrites en local quand ARCHIVE_DIR n'est pas défini.
# Le "/" initial ancre la règle à la racine du dépôt : sans lui, le motif
# matcherait aussi app/admin/archives/, la page d'administration.
/archives/

# Campagne d'invitation des directions : l'aperçu est régénérable, et le
# journal contient les adresses réellement contactées (cf. scripts/inviter-directions.ts).
/data/apercu-invitation.html
/data/prospection-journal.csv
/data/collecte-rapport.csv
/data/prospection-ecoles.csv
# Pouvoirs organisateurs : fichier de travail, rapport et journal, plus les
# copies locales des sources publiques (signalétique FWB, sites des communes).
/data/prospection-po.csv
/data/prospection-po-journal.csv
/data/collecte-po-rapport.csv
/data/fwb-signaletique.json
/data/communes-sites.json
/data/prospection.xlsx
# Reprise de l'annuaire par les données CPEONS (cf. scripts/importer-cpeons.ts,
# exporter-fwb-schools.ts) : rapport de reprise et export de travail, tous deux
# régénérables à la commande.
/data/import-cpeons-rapport.csv
/data/prospection-toutes-ecoles.csv
# Fichiers de campagne, quel que soit leur nom : un « -envoi » porte les
# établissements à contacter, un « -journal » les adresses réellement
# contactées. Jamais au dépôt, même pour un essai.
/data/*-envoi.csv
/data/*-journal.csv
